# Postgres
DATABASE_URL=postgres://localhost:5432/kardee_development?sslmode=disable

# API
PORT=8090

# Crawler
# User-Agent sent to the banks. Keep it honest; include a way to reach you.
CRAWL_USER_AGENT=Mozilla/5.0 (compatible; KardeeBot/0.1; +https://kardee.app)
# Seconds between requests to the same bank.
CRAWL_DELAY_SECONDS=1.5
# Detail pages fetched per bank per run; the rest wait for the next run.
CRAWL_DETAIL_LIMIT=150
# KTC lists every promotion it ever had; only look at ones changed in this many days.
KTC_MAX_AGE_DAYS=180
# Cron spec for cmd/jobs (Thai time). Default twice a day.
CRAWL_CRON=0 6,18 * * *
